# Isolated demo/simulation server. Copy to server/.env.demo and fill the blanks.
# Run: $env:MT15_ENV='server/.env.demo'; .\scripts\start-server.ps1 -Port 8001
# Never point scripts/simulate.py at the real database.
DEVICE_ID=mt15-demo
DEVICE_TOKEN=
ADMIN_USER=admin
ADMIN_PASSWORD=
DATABASE_PATH=data/demo.sqlite3
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL=
LOW_BATTERY_VOLTAGE=11.8
