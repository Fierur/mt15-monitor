# Copy to server/.env, or run scripts/setup_server.py to generate credentials.
DEVICE_ID=mt15-001
DEVICE_TOKEN=
# Used by scripts/start-server.ps1 -Supabase. Set the publishable key from Project Connect.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
ADMIN_USER=admin
ADMIN_PASSWORD=
# Local testing only: allow ADMIN_PASSWORD shorter than 12 chars (e.g. 123456).
# scripts/start-tunnel.ps1 still refuses to publish with a password under 16 chars.
ALLOW_WEAK_ADMIN_PASSWORD=
DATABASE_PATH=data/mt15.sqlite3
# Gmail: smtp.gmail.com, port 587 (STARTTLS), SMTP_USER = Gmail address,
# SMTP_PASSWORD = 16-character App Password (requires 2-Step Verification).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL=
# Alert when two consecutive engine-off samples fall below this voltage.
# 11.8 suits a 12 V sealed lead-acid (MF/AGM) battery; LiFePO4 needs ~12.8.
# Leave empty to disable. Accuracy depends on ADC calibration (docs/CALIBRATION.md).
LOW_BATTERY_VOLTAGE=11.8
